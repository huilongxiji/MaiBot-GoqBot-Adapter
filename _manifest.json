{
  "manifest_version": 2,
  "id": "onebot-ws.goqbot-adapter",
  "version": "0.2.0",
  "name": "goqbot 适配器 / GoqBot Adapter",
  "description": "通过 OneBot V11 正向/反向 WebSocket 连接 goqbot（QQ 官方机器人协议端），可与 NoneBot 等框架共用同一个机器人",
  "author": {
    "name": "huilongxiji",
    "url": "https://github.com/huilongxiji"
  },
  "license": "AGPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/huilongxiji/MaiBot-GoqBot-Adapter",
    "homepage": "https://github.com/huilongxiji/MaiBot-GoqBot-Adapter",
    "documentation": "https://github.com/huilongxiji/MaiBot-GoqBot-Adapter#readme",
    "issues": "https://github.com/huilongxiji/MaiBot-GoqBot-Adapter/issues"
  },
  "plugin_type": "adapter",
  "changelog": "CHANGELOG.md",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "bot"
    }
  },
  "host_application": {
    "min_version": "1.3.18",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.19.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "component.disable",
    "component.enable",
    "message.get_by_id"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
